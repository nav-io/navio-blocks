# Mainnet indexer config — copy to .env.mainnet (gitignored).
# Loaded first (via ENV_FILE=.env.mainnet); the base .env fills any gaps.

NETWORK=mainnet

# Mainnet naviod RPC (chainparams: rpc 48471, p2p 48470)
RPC_HOST=127.0.0.1
RPC_PORT=48471
RPC_USER=
RPC_PASSWORD=

# Mainnet database (must match the API's DB_PATH)
DB_PATH=./navio-blocks.mainnet.db

# --- Optional: BSC wNAV bridge (mainnet wNAV contract on BSC mainnet) ---
# BSC_WNAV_ENABLED=1
# BSC_CHAIN=mainnet
# BSC_WNAV_ADDRESS=0x...
# BSC_WNAV_NOTE_PREFIX=nav1
