# Mainnet indexer config — copy to .env.mainnet (gitignored).
# Loaded first (via ENV_FILE=.env.mainnet); the base .env fills any gaps.

NETWORK=mainnet

# Mainnet naviod RPC (chainparams: rpc 48471, p2p 48470)
RPC_HOST=127.0.0.1
RPC_PORT=48471
RPC_USER=
RPC_PASSWORD=

# Mainnet database (must match the API's DB_PATH)
DB_PATH=./navio-blocks.mainnet.db

# --- Optional: BSC wNAV bridge (mainnet wNAV contract on BSC mainnet) ---
# Indexes BurnedWithNote logs from the wNAV BEP-20 contract and keeps only
# burns whose note starts with the mainnet prefix (nav1). Enabled by default
# unless BSC_WNAV_ENABLED=0.
# BSC_WNAV_ENABLED=1
# BSC_CHAIN=mainnet
# BSC_WNAV_ADDRESS=0x...
# BSC_WNAV_NOTE_PREFIX=nav1
# Single-knob RPC (seeds both HTTP + derived WSS; use an archive provider so
# historical getLogs works). Overridden per-transport by BSC_HTTP_URL/BSC_WSS_URL.
# BSC_RPC_URL=https://your-provider.example/key/
# Cold-start block for the historical backfill (only used when no cursor exists
# yet). Set to the bridge's first burn block to scan the full history; otherwise
# the watcher starts at tip-50k.
# BSC_START_BLOCK=107599429
