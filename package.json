{
  "name": "navio-blocks",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/indexer",
    "packages/api",
    "packages/frontend"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-navio-sdk-external-better-sqlite3.cjs",
    "build:shared": "npm -w packages/shared run build",
    "dev:indexer:mainnet": "ENV_FILE=.env.mainnet npm -w packages/indexer run dev",
    "dev:indexer:testnet": "ENV_FILE=.env.testnet npm -w packages/indexer run dev",
    "dev:api": "npm -w packages/api run dev",
    "dev:frontend": "npm -w packages/frontend run dev",
    "dev": "concurrently -n MAIN,TEST,API,WEB -c blue,cyan,green,magenta \"npm:dev:indexer:mainnet\" \"npm:dev:indexer:testnet\" \"npm:dev:api\" \"npm:dev:frontend\"",
    "build": "npm -w packages/shared run build && npm -w packages/indexer run build && npm -w packages/api run build && npm -w packages/frontend run build",
    "start": "concurrently -n MAIN,TEST,API -c blue,cyan,green \"npm:start:indexer:mainnet\" \"npm:start:indexer:testnet\" \"npm:start:api\"",
    "start:indexer:mainnet": "ENV_FILE=.env.mainnet npm -w packages/indexer run start",
    "start:indexer:testnet": "ENV_FILE=.env.testnet npm -w packages/indexer run start",
    "start:api": "npm -w packages/api run start",
    "reindex": "npm -w packages/indexer run reindex",
    "reindex:from": "npm -w packages/indexer run reindex:from --",
    "reindex:mainnet": "ENV_FILE=.env.mainnet npm -w packages/indexer run reindex",
    "reindex:testnet": "ENV_FILE=.env.testnet npm -w packages/indexer run reindex"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
