# Testnet indexer config — copy to .env.testnet (gitignored).
# Loaded first (via ENV_FILE=.env.testnet); the base .env fills any gaps.

NETWORK=testnet

# Testnet naviod RPC (chainparams testnet7: rpc 33677, p2p 33670)
RPC_HOST=127.0.0.1
RPC_PORT=33677
RPC_USER=
RPC_PASSWORD=

# Testnet database (must match the API's TESTNET_DB_PATH).
# To reuse an existing testnet DB, point this at it (e.g. ./navio-blocks.db).
DB_PATH=./navio-blocks.testnet.db

# --- Optional: BSC wNAV bridge (testnet wNAV contract on BSC testnet) ---
# BSC_WNAV_ENABLED=1
# BSC_CHAIN=testnet
# BSC_WNAV_ADDRESS=0x...
# BSC_WNAV_NOTE_PREFIX=tnv1
